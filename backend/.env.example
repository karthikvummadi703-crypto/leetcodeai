# ============================================================
# LeetCode Guidance AI — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit your .env file to version control.
# ============================================================

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Firebase Admin SDK ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Application ---
APP_ENV=development
LOG_LEVEL=DEBUG
BACKEND_URL=http://localhost:8000
# Comma-separated list of allowed frontend origins in production
# (e.g. https://myapp.web.app,https://myapp.firebaseapp.com).
FRONTEND_URL=http://localhost:5173

# --- Rate limiting (per-user, sliding window) ---
# Enabled by default. Set to false to disable entirely.
RATE_LIMIT_ENABLED=true
# Max requests per user per window below.
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
