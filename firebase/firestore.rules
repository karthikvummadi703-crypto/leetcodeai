rules_version = '2';

// Conversations and feedback are private to the owning user.
// The frontend does NOT read/write Firestore directly — it talks to the
// FastAPI backend, which uses the Firebase Admin SDK (bypassing these
// rules). These rules exist as a defense-in-depth layer so that no client
// can ever read another user's data even if the API were misconfigured.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Deny everything by default.
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/conversations/$(conversationId)).data.uid == request.auth.uid;
        allow write: if signedIn() && get(/databases/$(database)/documents/conversations/$(conversationId)).data.uid == request.auth.uid;
      }
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
